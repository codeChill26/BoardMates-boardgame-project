// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------
// 1. KHAI BÁO CÁC ENUM Ở ĐÂY
// ----------------------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ListingType {
  SELL
  RENT
  EXCHANGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  phone     String?
  avatarUrl String?

  city      String?
 // lat       Float?
//lng       Float?

  role      Role        @default(USER)
  status    UserStatus  @default(ACTIVE)

  createdAt DateTime @default(now())

  listings  Listing[]
  shelfGames ShelfGame[]
}

model BoardGame {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  categories  String[] @default([])
  minPlayers  Int?
  maxPlayers  Int?
  playTime    Int?
  age         Int?
  publisher   String?
  imageUrl    String?

  listings    Listing[]
  shelfItems  ShelfGame[]
}

model Listing {
  id          Int      @id @default(autoincrement())
  userId      Int
  gameId      Int

  type        ListingType
  price       Float?
  rentPrice   Float?
  condition   String?

  description String?
  status      String   @default("ACTIVE")

  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id])
  game        BoardGame @relation(fields: [gameId], references: [id])

  orders      Order[]
}

model Order {
  id              Int      @id @default(autoincrement())
  buyerId         Int
  listingId       Int

  type            ListingType
  status          OrderStatus @default(PENDING)
  totalPrice      Float?

  startDate       DateTime?
  endDate         DateTime?

  meetingAddress  String?
  meetingLat      Float?
  meetingLng      Float?

  createdAt       DateTime @default(now())

  listing         Listing @relation(fields: [listingId], references: [id])
}

model ShelfGame {
  id                 Int       @id @default(autoincrement())
  userId             Int
  gameId             Int
  condition          String?   @default("Like New") // Like New, Mới 100%, Đã bọc bài (Sleeved), Đã qua sử dụng
  status             String    @default("ON_SHELF") // ON_SHELF (Trên kệ), LENT_OUT (Đang cho mượn), FOR_SALE (Muốn bán), WISHLIST (Yêu thích)
  borrower           String?   // Tên người mượn
  borrowedDate       DateTime? // Ngày cho mượn
  expectedReturnDate DateTime? // Ngày hẹn trả
  personalNotes      String?   // Ghi chú cá nhân (kèm bản mở rộng, phụ kiện...)
  personalRating     Float?    // Đánh giá cá nhân (1 - 5)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game               BoardGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}