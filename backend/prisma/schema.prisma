// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------
// 1. KHAI BÁO CÁC ENUM Ở ĐÂY
// ----------------------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ListingType {
  SELL
  RENT
  EXCHANGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum EventType {
  CASUAL      // Lên kèo giao lưu nhanh
  TOURNAMENT  // Giải đấu
  WORKSHOP    // Hướng dẫn / Trải nghiệm game mới
  NIGHT       // Board Game Night cộng đồng
}

enum EventStatus {
  OPEN       // Đang mở slot
  FULL       // Đã đủ người
  ONGOING    // Đang diễn ra
  COMPLETED  // Đã kết thúc
  CANCELLED  // Đã hủy
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  phone     String?
  avatarUrl String?

  city      String?
 // lat       Float?
//lng       Float?

  role      Role        @default(USER)
  status    UserStatus  @default(ACTIVE)

  createdAt DateTime @default(now())

  listings  Listing[]
  shelfGames ShelfGame[]
  hostedEvents Event[] @relation("EventHost")
  eventParticipations EventParticipant[]
}

model BoardGame {
  id          Int      @id @default(autoincrement())
  bggId       Int?
  name        String
  description String?
  categories  String[] @default([])
  minPlayers  Int?
  maxPlayers  Int?
  playTime    Int?
  age         Int?
  publisher   String?
  imageUrl    String?
  weight      Float?   // Độ khó BGG (1.0 - 5.0)
  bggRating   Float?   // Điểm đánh giá BGG (1.0 - 10.0)
  bggRank     Int?     // Thứ hạng BGG

  listings    Listing[]
  shelfItems  ShelfGame[]
  events      Event[]
}

model Listing {
  id          Int      @id @default(autoincrement())
  userId      Int
  gameId      Int

  type        ListingType
  price       Float?
  rentPrice   Float?
  condition   String?

  description String?
  status      String   @default("ACTIVE")

  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id])
  game        BoardGame @relation(fields: [gameId], references: [id])

  orders      Order[]
}

model Order {
  id              Int      @id @default(autoincrement())
  buyerId         Int
  listingId       Int

  type            ListingType
  status          OrderStatus @default(PENDING)
  totalPrice      Float?

  startDate       DateTime?
  endDate         DateTime?

  meetingAddress  String?
  meetingLat      Float?
  meetingLng      Float?

  createdAt       DateTime @default(now())

  listing         Listing @relation(fields: [listingId], references: [id])
}

model ShelfGame {
  id                 Int       @id @default(autoincrement())
  userId             Int
  gameId             Int
  condition          String?   @default("Like New") // Like New, Mới 100%, Đã bọc bài (Sleeved), Đã qua sử dụng
  status             String    @default("ON_SHELF") // ON_SHELF (Trên kệ), LENT_OUT (Đang cho mượn), FOR_SALE (Muốn bán), WISHLIST (Yêu thích)
  borrower           String?   // Tên người mượn
  borrowedDate       DateTime? // Ngày cho mượn
  expectedReturnDate DateTime? // Ngày hẹn trả
  personalNotes      String?   // Ghi chú cá nhân (kèm bản mở rộng, phụ kiện...)
  personalRating     Float?    // Đánh giá cá nhân (1 - 5)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game               BoardGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Event {
  id              Int          @id @default(autoincrement())
  title           String
  description     String?
  eventType       EventType    @default(CASUAL)
  status          EventStatus  @default(OPEN)

  gameId          Int?
  customGameName  String?
  games           Json?        // Danh sách nhiều board game đính kèm: [{ id, name, imageUrl, bggId, playTime, weight }]
  imageUrl        String?

  hostId          Int
  location        String       // Tên quán cafe, địa điểm (vd: The Mind Cafe, Board Mates Hub, Online...)
  address         String?      // Địa chỉ chi tiết
  city            String?      @default("TP. Hồ Chí Minh")
  lat             Float?       // Vĩ độ GPS
  lng             Float?       // Kinh độ GPS

  startDate       DateTime
  endDate         DateTime?

  maxParticipants Int          @default(4)
  entryFee        Float?       @default(0) // 0 = Miễn phí / Tự túc tiền nước
  skillLevel      String?      @default("ALL") // ALL, BEGINNER, INTERMEDIATE, EXPERT

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  host            User         @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  game            BoardGame?   @relation(fields: [gameId], references: [id], onDelete: SetNull)
  participants    EventParticipant[]
}

model EventParticipant {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  role      String   @default("PLAYER") // HOST, PLAYER, SPECTATOR
  status    String   @default("JOINED") // JOINED, WAITLIST, CANCELLED
  notes     String?
  joinedAt  DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}