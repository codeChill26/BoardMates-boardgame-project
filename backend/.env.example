# Database connection string
# Replace <username>, <password>, <host>, <port>, and <database> with your actual database credentials
DATABASE_URL="postgres://<username>:<password>@localhost:5432/<database>"
JWT_SECRET="your_jwt_secret_here"
PORT = "8080"
# GOOGLE OAUTH 2.0 CONFIG
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:8080/api/auth/google/callback"
FRONTEND_URL="http://localhost:3000"
# Khoa quan tri cho console tuyen dung (/bm-console-7k29x). Bat buoc phai co,
# neu khong moi thao tac ghi len /api/positions deu bi tu choi.
ADMIN_SECRET="your_admin_secret_here"
