# Copy to ai/.env and fill values

# --- Ollama (local LLM) ---
# Default Ollama host (Windows app typically listens here)
OLLAMA_HOST=http://localhost:11434
# For fast local testing, prefer SMALL models (download with: `ollama pull <model>`)
# Examples (fast): qwen2.5:0.5b, qwen2.5:1.5b, gemma2:2b
# Examples (better quality, slower): llama3.1, mistral, deepseek-r1
OLLAMA_MODEL=qwen2.5:0.5b

# Speed knobs (use smaller values for faster tests)
# num_predict = max tokens generated per response
OLLAMA_NUM_PREDICT=128
# num_ctx = context window; smaller reduces memory/latency
OLLAMA_NUM_CTX=2048
# temperature = randomness
OLLAMA_TEMPERATURE=0.2

# --- Embeddings ---
# Sentence-Transformers model name (auto-downloads on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector DB (Chroma) ---
# Persistent directory for vectors (relative to repo root is okay)
CHROMA_DIR=ai/data/chroma
CHROMA_COLLECTION=boardgame_knowledge

# --- Optional: OpenAI (cloud fallback) ---
OPENAI_API_KEY=
# If you use a compatible endpoint (Azure/OpenRouter/local), set base URL:
OPENAI_BASE_URL=
