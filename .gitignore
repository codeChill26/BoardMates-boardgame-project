/coverage
/.nyc_output

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.env.*
!.env.example
!.env-example

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS / Misc
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

